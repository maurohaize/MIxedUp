# Normalise line endings; Unity writes LF
* text=auto eol=lf

# Unity YAML assets are text
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.inputactions text eol=lf
*.cs text eol=lf
*.csv text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.tga binary
*.exr binary
*.fbx binary
*.FBX binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary
*.otf binary
*.dll binary
